# ========================================================
# EXPLORE INDIA FULL-STACK CONFIGURATION
# ========================================================

# ── Local MariaDB / MySQL Configuration (XAMPP) ──
# Exact Database Name: explore_india
DB_URL=jdbc:mysql://localhost:3306/explore_india?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# ── Spring Boot Backend Configuration ──
# Port: 8080 | Context Path: /api
SERVER_PORT=8080
JWT_SECRET=9a4f2c8d3b7a1e6f5c8d0e2b4a7c9f1e3a5b7d9f2e4a6c8b0d2e4f6a8c0e2b4a
JWT_EXPIRATION=86400000
UPLOAD_DIRECTORY=./uploads

# ── React + Vite Frontend Configuration ──
# Local Full-Stack Connection (Spring Boot Backend)
VITE_API_BASE_URL=http://localhost:8080/api

# Vite Development Proxy Target
VITE_API_PROXY_TARGET=http://localhost:8080
PORT=3000
